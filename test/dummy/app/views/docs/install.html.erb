<% dummy_page_nav(title: "Install", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Install",
    subtitle: "Host-app setup for the mounted Recording Studio Conversions engine.",
    variant: :h1
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Add the gem",
    subtitle: "Pin Recording Studio from GitHub, then this addon.",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~CODE
      gem "recording_studio_conversions", github: "bowerbird-app/RecordingStudio_conversions"
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Mount and migrate",
    subtitle: "Generators copy the initializer and tables into the host.",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :bash,
    code: <<~CODE
      bin/rails generate recording_studio_conversions:install
      bin/rails generate recording_studio_conversions:migrations
      bin/rails db:migrate
    CODE
  ) %>
</div>
