<% dummy_page_nav(title: "Methods", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Methods",
    subtitle: "The public conversion helpers a host calls.",
    variant: :h1
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Record consent",
    subtitle: "RecordingStudioConversions.record_consent!",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      RecordingStudioConversions.record_consent!(
        visitor_id: visitor_id,
        category: "advertising",
        granted: true
      )
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Record the acquisition user",
    subtitle: "RecordingStudioConversions.record_acquisition_user!",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      RecordingStudioConversions.record_acquisition_user!(
        root_recording_id: workspace_root.id,
        user_id: user.id
      )
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Read attribution",
    subtitle: "RecordingStudioConversions.attribution_for",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      result = RecordingStudioConversions.attribution_for(
        root_recording_id: workspace_root.id
      )
      result.observations
    CODE
  ) %>
</div>
