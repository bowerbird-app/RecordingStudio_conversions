<% dummy_page_nav(title: "Attribution", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Attribution",
    subtitle: "Dummy-only inspector for this browser's device. Development and test only.",
    variant: :h1
  ) %>

  <p class="text-sm leading-6">
    Device <code><%= @visitor_id.presence || "missing" %></code>.
    Signed in as <code><%= current_user.email %></code>.
    Open <code>/?fbclid=TEST123&amp;utm_source=meta</code>, grant advertising consent, then open that URL again.
  </p>

  <% if notice.present? %>
    <p class="text-sm"><%= notice %></p>
  <% end %>
  <% if alert.present? %>
    <p class="text-sm"><%= alert %></p>
  <% end %>

  <section class="flex flex-col gap-3">
    <h2 class="text-lg font-semibold">Consent</h2>
    <% if @categories.empty? %>
      <p class="text-sm">No consent categories are configured.</p>
    <% else %>
      <div class="flex flex-wrap gap-2">
        <% @categories.each do |category| %>
          <%= button_to "Grant #{category}", attribution_consent_path, params: { category: category, granted: true } %>
          <%= button_to "Revoke #{category}", attribution_consent_path, params: { category: category, granted: false } %>
        <% end %>
      </div>
    <% end %>
  </section>

  <section class="flex flex-col gap-3">
    <h2 class="text-lg font-semibold">Resolution</h2>
    <% if @root %>
      <p class="text-sm">Selected root <code><%= @root.id %></code></p>
      <%= button_to "Use me as the acquisition user", attribution_acquisition_path %>
    <% else %>
      <p class="text-sm">No workspace root is selected. Use the workspace switcher, then come back.</p>
    <% end %>
    <% @resolved.each do |item| %>
      <p class="text-sm">
        Root <code><%= item[:root_id] %></code>
        subject <code><%= item[:subject_id] %></code>
        status <code><%= item[:status] %></code>
      </p>
      <ul class="text-sm">
        <% item[:values].each do |value| %>
          <li><%= value %></li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <section class="flex flex-col gap-3">
    <h2 class="text-lg font-semibold">Another confirmed user</h2>
    <%= form_with url: attribution_users_path do |form| %>
      <div class="flex flex-wrap items-end gap-3">
        <%= form.email_field :email, required: true, placeholder: "second@example.com", class: "border px-2 py-1" %>
        <%= form.password_field :password, required: true, value: "Password", class: "border px-2 py-1" %>
        <%= form.submit "Create confirmed user" %>
      </div>
    <% end %>
  </section>

  <section class="flex flex-col gap-3">
    <h2 class="text-lg font-semibold">Identity links</h2>
    <table class="text-sm">
      <thead>
        <tr>
          <th>Linked at</th><th>User</th><th>Device</th><th>Confirmed</th><th></th>
        </tr>
      </thead>
      <tbody>
        <% @links.each do |link| %>
          <tr>
            <td><%= link.linked_at.utc.iso8601 %></td>
            <td><%= @users[link.user_id.to_s]&.email || link.user_id %></td>
            <td><%= link.visitor_id %></td>
            <td><%= link.confirmed %></td>
            <td><%= button_to "Delete attribution", attribution_user_path(link.user_id), method: :delete %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>

  <section class="flex flex-col gap-3">
    <h2 class="text-lg font-semibold">Consents</h2>
    <table class="text-sm">
      <thead>
        <tr>
          <th>Recorded at</th><th>User</th><th>Device</th><th>Category</th><th>State</th>
        </tr>
      </thead>
      <tbody>
        <% @consents.each do |row| %>
          <tr>
            <td><%= row.recorded_at.utc.iso8601 %></td>
            <td><%= @users[row.user_id.to_s]&.email || "anonymous" %></td>
            <td><%= row.visitor_id %></td>
            <td><%= row.category %></td>
            <td><%= row.withdrawn_at.present? || !row.granted ? "withdrawn" : "granted" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>

  <section class="flex flex-col gap-3">
    <h2 class="text-lg font-semibold">Observations</h2>
    <table class="text-sm">
      <thead>
        <tr>
          <th>Captured at</th><th>Device</th><th>Category</th><th>Field</th><th>Value</th>
        </tr>
      </thead>
      <tbody>
        <% @observations.each do |row| %>
          <tr>
            <td><%= row.captured_at.utc.iso8601 %></td>
            <td><%= row.visitor_id %></td>
            <td><%= row.consent_category %></td>
            <td><%= row.field_name %></td>
            <td><%= row.value %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
</div>
